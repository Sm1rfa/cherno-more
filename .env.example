# ---- api.goal.bg (fixtures + standings) ----
# Key is issued manually — email api@bgclubs.eu to request one.
VITE_GOALBG_KEY=your_goalbg_key_here

# goal.bg's team id, format "<club_id>-111" — use the Discovery tab in the
# app (search clubs, then look up its teams) to find Cherno More Varna's.
VITE_GOALBG_TEAM_ID=

# Bulgarian First League on goal.bg — this is their own docs example and is
# very likely correct, but double-check via the Discovery tab if in doubt.
VITE_GOALBG_TOURNAMENT_ID=1000000

# ---- Squad data ----
# No free API has current-season player data, so the Squad tab reads from
# src/data/squad.ts, which you maintain by hand. Nothing to configure here.
